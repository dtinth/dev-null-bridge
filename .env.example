# Copy to bridge.env and fill in. Used with: docker run --env-file bridge.env ...

# Where the server is reached over HTTPS (login links, GitHub callback).
BRIDGE_PUBLIC_URL=https://bridge.example.com

# Whose replies count and who may use the web UI; the account agents post as.
BRIDGE_AUTHORS=your-username
BRIDGE_BOT_USER=your-bot-username

# The bot's SSH key, its public half on the bot's GitHub. One line each: --env-file has no
# multi-line values, so write newlines as \n. To print the private key that way:
#   awk '{printf "%s\\n", $0}' ~/.ssh/your_bot_key
BRIDGE_SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----\n
BRIDGE_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... your-bot-username

# A GitHub OAuth app with the callback URL <BRIDGE_PUBLIC_URL>/auth/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 32+ random characters: openssl rand -hex 32
BRIDGE_SESSION_SECRET=
