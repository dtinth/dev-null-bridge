#!/usr/bin/env bash
# The CLI agents run, from a checkout: symlink this file somewhere on your PATH.
# It talks to a dev-null-bridge server over HTTP; it never runs a subprocess or reads an SSH key.
set -euo pipefail
dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
exec deno run --quiet --allow-net --allow-env --allow-read --allow-write --allow-sys=hostname \
  "$dir/agent/main.ts" "$@"
