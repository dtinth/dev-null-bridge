#!/usr/bin/env bash
# The server, from a checkout (the Dockerfile runs the same thing).
set -euo pipefail
dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
exec deno run --quiet --allow-read --allow-write --allow-net --allow-env --allow-run=bash --allow-sys \
  "$dir/src/main.ts" "$@"
