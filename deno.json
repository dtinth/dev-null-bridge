{
  "name": "@dtinth/dev-null-bridge",
  "version": "0.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "server": "deno run --allow-read --allow-write --allow-net --allow-env --allow-run=bash,ssh-keygen --allow-sys src/main.ts serve",
    "test": "deno test --allow-read --allow-write --allow-net --allow-env --allow-sys",
    "check": "deno check src/ agent/",
    "ci": "deno fmt --check && deno lint && deno check src/ agent/ && deno task test"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/yaml": "jsr:@std/yaml@^1.0.5"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "README.md",
      "skills",
      "docs"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
